# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)

# 배포 도메인. metadata / sitemap.xml / robots.txt 에 사용됩니다.
NEXT_PUBLIC_SITE_URL=https://wongago.com

# Supabase - 대시보드 → Project Settings → General 의 "Project URL" 에서 복사
# ("Data API" 화면의 REST 엔드포인트(.../rest/v1/)와 다른 값입니다. 경로 없이 도메인만 넣으세요.
#  예) https://xxxxxxxx.supabase.co  -- 코드에서 뒤에 붙은 경로는 자동으로 제거하지만 깔끔하게 두는 게 좋습니다.)
# 두 값이 모두 있어야 서버 로그인이 켜집니다. 비어 있으면 브라우저 로컬 계정 방식으로 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 주의: service_role 키는 절대 넣지 마세요. 브라우저에 노출되면 모든 데이터가 열립니다.
# 여기 넣는 것은 공개되어도 되는 anon(public) 키입니다.

# 구글 애널리틱스(GA4) 속성 ID. analytics.google.com 에서 "G-"로 시작하는 값을 복사하세요.
# 비어 있으면 애널리틱스 없이 그대로 동작합니다.
NEXT_PUBLIC_GA_ID=
